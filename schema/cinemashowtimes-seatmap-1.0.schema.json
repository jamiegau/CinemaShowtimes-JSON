{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinemashowtimes.org/schema/cinemashowtimes-seatmap-1.0.schema.json",
  "title": "CinemaShowtimes static seat map 1.0",
  "description": "A versioned auditorium layout. Live sale state belongs at the session availability endpoint.",
  "type": "object",
  "required": ["spec", "auditorium_id", "layout_id", "version", "updated_at", "coordinate_system", "sections"],
  "properties": {
    "spec": { "const": "cinemashowtimes-seatmap/1.0" },
    "auditorium_id": { "type": "string", "minLength": 1 },
    "layout_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "coordinate_system": {
      "type": "object",
      "required": ["width", "height", "origin"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "enum": ["top_left", "bottom_left"] },
        "unit": { "enum": ["abstract", "px", "m", "ft"] }
      },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["x", "y", "width"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "name", "rows"],
        "properties": {
          "section_id": { "type": "string" },
          "name": { "type": "string" },
          "polygon": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["row_id", "label", "seats"],
              "properties": {
                "row_id": { "type": "string" },
                "label": { "type": "string" },
                "seats": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["seat_id", "label", "x", "y", "type"],
                    "properties": {
                      "seat_id": { "type": "string" },
                      "label": { "type": "string" },
                      "x": { "type": "number" },
                      "y": { "type": "number" },
                      "type": { "enum": ["seat", "wheelchair_space", "companion", "loveseat", "standing", "obstruction"] },
                      "class_id": { "type": "string" },
                      "features": {
                        "type": "array",
                        "items": { "enum": ["aisle", "recliner", "motion", "restricted_view", "removable", "transfer_arm", "other"] }
                      },
                      "paired_with": { "type": "array", "items": { "type": "string" } }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
